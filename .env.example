DATABASE_URL="postgresql://finarc:finarc@localhost:5432/finarc?schema=public"

# Optional hardening for public deployments.
# FINARC_AUTH_SECRET signs browser sessions. If absent, Finarc falls back to server env such as DATABASE_URL.
# FINARC_AUTH_SECRET="replace-with-a-long-random-string"

# Optional but recommended for Document Vault. Keep this value unchanged on every
# deployment that needs to read or restore the same encrypted documents.
# FINARC_DOCUMENT_SECRET="replace-with-a-separate-long-random-string"

# Optional: require this for /api/cron/notify via Bearer token, x-finarc-cron-secret, or ?secret=...
# FINARC_CRON_SECRET="replace-with-a-long-random-string"

# Optional: Telegram setWebhook will register this secret_token, and incoming webhooks must include it.
# FINARC_TELEGRAM_WEBHOOK_SECRET="replace-with-a-long-random-string"
